# Admin-Passwort für /admin
ADMIN_PASSWORD=bitte-aendern

# Upstash Redis (Vercel Marketplace → Upstash). Setzt automatisch KV_REST_API_URL/TOKEN
# oder UPSTASH_REDIS_REST_URL/TOKEN. Ohne diese Variablen läuft lokal ein In-Memory-Speicher.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vestaboard Read/Write API Key (Vestaboard Web-App → Settings → Developer → Read/Write API)
VESTABOARD_RW_KEY=
# Unterste Zeile auf dem Board (z. B. kurze URL zur Abstimmung)
VESTABOARD_FOOTER=JETZT VOTEN!

# Optional: neue Fragen per Claude generieren, wenn die Warteschlange leer ist
ANTHROPIC_API_KEY=

# Wechsel-Intervall in Stunden (Standard 48)
ROTATE_HOURS=48

# Von Vercel automatisch für Cron-Aufrufe gesetzt, wenn du sie im Projekt anlegst
CRON_SECRET=
